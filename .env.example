# ============================================================
# Knowledge Repository - 环境变量模板
# ============================================================
# 使用方法：
#   cp .env.example .env
#   然后编辑 .env 填入实际的敏感信息
#
# 重要：.env 包含敏感凭据，已在 .gitignore 中排除。
#       此模板文件可安全提交到代码仓库。
# ============================================================

# ==================== 应用版本 ====================
APP_VERSION=V1.0.0
IMAGE_NAME=knowledge-repository

# ==================== 敏感凭据（必须修改） ====================
# MySQL root 密码（请使用强密码，至少 12 位，包含大小写字母、数字和特殊字符）
MYSQL_PASSWORD=your-strong-mysql-password
# Chat 角色 API Key（默认 DeepSeek，从 https://platform.deepseek.com 获取）
LLM_CHAT_API_KEY=your-deepseek-api-key
# 可选：per-role 覆盖（默认见 application.yml；仅切换供应商/端点时才需取消注释）
# LLM_CHAT_PROVIDER=deepseek
# LLM_CHAT_BASE_URL=https://api.deepseek.com
# LLM_CHAT_MODEL=deepseek-flash
# LLM_EMBED_PROVIDER=ollama
# LLM_EMBED_BASE_URL=http://localhost:11434/v1
# LLM_EMBED_MODEL=bge-m3
# 视觉角色（Phase B，默认关闭）：仅本地 PaddleOCR-CPU / 云端视觉端点接入时取消注释并置 enabled=true
# LLM_VISION_ENABLED=true
# LLM_VISION_MODE=local-cpu
# LLM_VISION_BASE_URL=http://localhost:8080/v1
# LLM_VISION_API_KEY=your-vision-key
# LLM_VISION_MODEL=paddleocr-vl
# MinIO 对象存储访问凭据
MINIO_ACCESS_KEY=your-minio-access-key
MINIO_SECRET_KEY=your-minio-secret-key
# Spring Security 管理员凭据（用于 admin.html 管理后台登录）
SPRING_SECURITY_USER=admin
SPRING_SECURITY_PASSWORD=your-admin-password
