<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.mouhin.knowledge</groupId>
        <artifactId>knowledge-repository</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>knowledge-client</artifactId>
    <name>Knowledge Client</name>
    <description>Client layer: external contract - Service interfaces + Command/Query/Response DTOs. Must not depend on domain/infrastructure.</description>

    <dependencies>
        <!-- Jackson annotations only (for response DTO serialization control); no domain dependency allowed -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>

        <!-- Bean validation annotations (jakarta) for command/query field constraints -->
        <dependency>
            <groupId>jakarta.validation</groupId>
            <artifactId>jakarta.validation-api</artifactId>
        </dependency>

        <!-- COLA unified response contract (Response / SingleResponse / MultiResponse / PageResponse) -->
        <dependency>
            <groupId>com.alibaba.cola</groupId>
            <artifactId>cola-component-dto</artifactId>
            <version>5.0.0</version>
        </dependency>
    </dependencies>
</project>
