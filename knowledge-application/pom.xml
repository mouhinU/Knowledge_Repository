<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.mouhin.knowledge</groupId>
        <artifactId>knowledge-repository</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>knowledge-application</artifactId>
    <name>Knowledge Application</name>
    <description>Application layer: use case orchestration, transaction management, DTO conversion</description>

    <dependencies>
        <!-- Domain module -->
        <dependency>
            <groupId>com.mouhin.knowledge</groupId>
            <artifactId>knowledge-domain</artifactId>
        </dependency>

        <!-- Infrastructure module (for repository implementations) -->
        <dependency>
            <groupId>com.mouhin.knowledge</groupId>
            <artifactId>knowledge-infrastructure</artifactId>
        </dependency>

        <!-- Spring Boot -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>

        <!-- Spring Transaction -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-tx</artifactId>
        </dependency>

        <!-- Spring Web (for MultipartFile in upload use case) -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-web</artifactId>
        </dependency>

        <!-- LangChain4j (for EmbeddingModel, EmbeddingStore types in application services) -->
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j</artifactId>
        </dependency>

        <!-- Spring Security Crypto (for BCrypt password encoding) -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-crypto</artifactId>
        </dependency>
    </dependencies>
</project>
